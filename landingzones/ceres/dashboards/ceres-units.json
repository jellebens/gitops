{
  "annotations": {
    "list": [
      {
        "name": "Dose",
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "changes(ceres_last_dose_timestamp_seconds{unit=\"${unit}\"}[1m]) > 0",
        "step": "1m",
        "titleFormat": "dose",
        "textFormat": "{{reagent}}",
        "tagKeys": "reagent",
        "useValueForTime": false
      }
    ]
  },
  "description": "Ceres — every hydroponic unit on the v2 tree (ceres/<unit>/…, ADR-0008): the Telegraf archive `ceres` bucket (unit_tele / unit_meta / unit_actuator, tagged unit) plus the Vertumnus's and Robigus's Prometheus series. Pick the unit at the top. The pre-cutover tower history is in the pomona bucket (dashboard 'Pomona — Hydroponics').",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "ceres",
    "hydroponics",
    "influxdb",
    "prometheus"
  ],
  "templating": {
    "list": [
      {
        "name": "unit",
        "label": "Unit",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"ceres\", tag: \"unit\", predicate: (r) => r._measurement == \"unit_tele\", start: -30d)",
        "definition": "tag values of unit",
        "current": {
          "selected": false,
          "text": "pomona-0001",
          "value": "pomona-0001"
        },
        "sort": 1
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Ceres — units",
  "uid": "ceres-units",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Node",
      "description": "ceres/${unit}/sys/status (retained LWT) via the archive.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "online": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 0
                },
                "offline": {
                  "text": "OFFLINE",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"ceres\") |> range(start: -7d) |> filter(fn: (r) => r._measurement == \"unit_meta\" and r.unit == \"${unit}\" and r.metric == \"status\" and r._field == \"value\") |> last() |> keep(columns: [\"_value\"]) |> rename(columns: {_value: \"Node\"})"
        }
      ]
    },
